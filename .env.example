# Conta Juntos — modelo de configuração.
# Copie para .env e preencha. O .env real é ignorado pelo Git e tem prioridade
# sobre variáveis de mesmo nome no ambiente do shell.

# ── Banco ─────────────────────────────────────────────────────────────────────
# Local (Docker, porta 5433):
# DATABASE_URL=postgres://app:app@localhost:5433/conta_juntos
# DATABASE_LISTEN_URL=postgres://app:app@localhost:5433/conta_juntos
# Supabase (pooler; sslmode=no-verify porque a CA própria não está no store do Node):
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=no-verify
DATABASE_LISTEN_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=no-verify

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
APP_ORIGIN=http://localhost:5173

# ── Segredos (obrigatórios em produção; dev tem defaults no config.ts) ────────
CRON_SECRET=change-me
# Keyring dos links de convite (§11.1): {"<kid>":"<hex 32 bytes>"}
JOIN_TOKEN_KEYS={"dev":"2f8c1e4a9b7d6053c1a2e8f4b9d7c3a05e6f1d2b3c4a5e6f708192a3b4c5d6e7"}
JOIN_TOKEN_CURRENT_KID=dev
# HMAC de auditoria/IP e das URLs de upload assinadas (hex)
AUDIT_HMAC_KEY=6f3a91c8d2e74b05a1f6c9d8e7b4a201

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=fake

# ── Storage de imagens (§10.4) ────────────────────────────────────────────────
# fs = disco local (dev/testes); supabase = bucket privado (produção)
STORAGE_PROVIDER=fs
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_STORAGE_KEY=change-me-service-key
SUPABASE_STORAGE_BUCKET=receipts
